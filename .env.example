# Supabase project settings (Project Settings > API)
# Use the pooled connection — Supabase's client library handles this
# automatically for you when you use the project URL below.

SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Same project URL and the public anon key, exposed to the browser for
# admin login/session handling. The anon key is safe to expose — it's
# constrained by Row Level Security. Project Settings > API > anon public.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# Service role key — server-side only, NEVER exposed to the browser.
# Project Settings > API > service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── SMS: Orange Cameroon ──
# Requires an enterprise API agreement with Orange Cameroon — contact
# your account rep for a client ID/secret and sender ID. See
# lib/sms/orange.ts for exactly what each variable does.
ORANGE_SMS_CLIENT_ID=
ORANGE_SMS_CLIENT_SECRET=
ORANGE_SMS_TOKEN_URL=
ORANGE_SMS_SEND_URL=
ORANGE_SMS_SENDER_ID=

# ── SMS: MTN Cameroon ──
# Requires an enterprise API agreement with MTN Cameroon. See
# lib/sms/mtn.ts for exactly what each variable does.
MTN_SMS_API_KEY=
MTN_SMS_SUBSCRIPTION_KEY=
MTN_SMS_SEND_URL=
MTN_SMS_SENDER_ID=
